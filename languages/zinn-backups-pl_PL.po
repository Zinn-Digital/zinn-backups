#. Plugin Name of the plugin
#: zinn-backups.php
#: includes/class-admin.php:50
msgid "Zinn® Backups"
msgstr "Zinn® Backups"

#. Plugin URI of the plugin
#: zinn-backups.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-backups"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-backups"

#. Description of the plugin
#: zinn-backups.php
msgid "Backs up your WordPress files and database to your own storage — Dropbox, Google Drive, Cloudflare R2, Amazon S3 or any S3-compatible bucket — restores them in one go, and imports backups made by other backup and migration plugins."
msgstr "Tworzy kopię zapasową twoich plików i bazy danych WordPress we własnym magazynie — Dropbox, Google Drive, Cloudflare R2, Amazon S3 lub dowolnym zasobniku zgodnym z S3 — przywraca je za jednym razem oraz importuje kopie zapasowe utworzone przez inne wtyczki do tworzenia kopii i migracji."

#. Author of the plugin
#: zinn-backups.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-backups.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-admin.php:69
#: includes/class-admin.php:174
msgid "Backups"
msgstr "Kopie zapasowe"

#: includes/class-admin.php:73
msgid "Get Pro: schedules, several storages, encryption"
msgstr "Kup Pro: harmonogramy, wiele miejsc docelowych, szyfrowanie"

