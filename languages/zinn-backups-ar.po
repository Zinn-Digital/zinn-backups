#. translators: %s: database error.
#: includes/class-table-swap.php:256
#, php-format
msgid "The restored tables could not be swapped in: %s. Your site is unchanged."
msgstr "تعذر استبدال الجداول المستعادة: %s. لم يطرأ أي تغيير على موقعك."

#: includes/class-uploads-pruner.php:83
