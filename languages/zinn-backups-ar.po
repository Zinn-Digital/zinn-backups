msgstr[2] "تعذر استبدال ملفات %1$s لأن هذا الموقع غير مسموح له بتعديلها، وتُركت كما هي: %2$s"
msgstr[3] "تعذر استبدال ملفات %1$s لأن هذا الموقع غير مسموح له بتعديلها، وتُركت كما هي: %2$s"
msgstr[4] "تعذر استبدال ملفات %1$s لأن هذا الموقع غير مسموح له بتعديلها، وتُركت كما هي: %2$s"
msgstr[5] "تعذر استبدال ملفات %1$s لأن هذا الموقع غير مسموح له بتعديلها، وتُركت كما هي: %2$s"

#. translators: %s: number of files.
#: includes/class-restore-job.php:407
