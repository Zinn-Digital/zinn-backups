#. translators: %s: file name.
#: includes/class-restore-job.php:470
#, php-format
msgid "%s did not match its checksum after downloading. The copy in storage may be damaged."
msgstr "لم يتطابق %s مع المجموع الاختباري الخاص به بعد التنزيل. قد تكون النسخة الموجودة في وحدة التخزين تالفة."

#. translators: %s: file name.
#: includes/class-restore-job.php:541
#, php-format
