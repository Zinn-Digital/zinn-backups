msgstr "لم يصل %s. يُرجى رفعه مرة أخرى."

#. translators: %s: list of backup formats.
#: includes/class-restore-job.php:563
#, php-format
msgid "Recognised: %s."
msgstr "تم التعرف عليه: %s."

#. translators: 1: number of files, 2: number of files skipped.
#: includes/class-restore-job.php:590
#, php-format
msgid "Imported %1$s files into wp-content (%2$s left out: caches, drop-ins and other backup plugins’ folders)."
msgstr "تم استيراد %1$s من الملفات إلى wp-content (تم استبعاد %2$s: التخزين المؤقت، وdrop-ins، ومجلدات إضافات النسخ الاحتياطي الأخرى)."

#: includes/class-restore-job.php:636
msgid "The archive has no database dump, so only files were imported."
msgstr "لا يحتوي الأرشيف على تفريغ لقاعدة البيانات، لذا تم استيراد الملفات فقط."

#. translators: %d: number of tables.
#: includes/class-restore-job.php:646
#, php-format
msgid "Database restored into %d temporary tables."
msgstr "تمت استعادة قاعدة البيانات في %d جداول مؤقتة."

#. translators: %s: file name.
#: includes/class-restore-job.php:663
#, php-format
msgid "%s has no WordPress tables in it and was skipped."
msgstr "لا يحتوي %s على أي جداول WordPress وتم تخطيه."

#: includes/class-restore-job.php:701
#: includes/class-table-swap.php:237
