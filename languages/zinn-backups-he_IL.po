#. Plugin Name of the plugin
#: zinn-backups.php
#: includes/class-admin.php:50
msgid "Zinn® Backups"
msgstr "Zinn® Backups"

#. Plugin URI of the plugin
#: zinn-backups.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-backups"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-backups"

#. Description of the plugin
#: zinn-backups.php
msgid "Backs up your WordPress files and database to your own storage — Dropbox, Google Drive, Cloudflare R2, Amazon S3 or any S3-compatible bucket — restores them in one go, and imports backups made by other backup and migration plugins."
msgstr "מגבה את קובצי ומסד הנתונים של ה-WordPress שלך לאחסון משלך — Dropbox, Google Drive, Cloudflare R2, Amazon S3 או כל יעד תואם S3 — משחזר אותם בפעם אחת, ומייבא גיבויים שנוצרו על ידי תוספי גיבוי והעברה אחרים."

#. Author of the plugin
#: zinn-backups.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-backups.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

