msgstr "بازیابی / درون‌ریزی"

#: includes/class-admin.php:348
msgid "Running"
msgstr "در حال اجرا"

#: includes/class-admin.php:360
msgid "Your storage"
msgid_plural "Your storage destinations"
msgstr[0] "فضای ذخیره‌سازی شما"
