msgstr "Анҷом ёфт"

#: includes/class-admin.php:112
#: includes/class-admin.php:346
msgid "Failed"
msgstr "Қатъ гардид"

#: includes/class-admin.php:113
#: includes/class-admin.php:347
msgid "Cancelled"
msgstr "Бекор карда шуд"

#: includes/class-admin.php:114
#: includes/class-admin.php:271
#: includes/class-admin.php:316
msgid "Cancel"
msgstr "Бекор кардан"

