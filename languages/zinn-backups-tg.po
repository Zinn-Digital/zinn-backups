#. Plugin Name of the plugin
#: zinn-backups.php
#: includes/class-admin.php:50
msgid "Zinn® Backups"
msgstr "Zinn® Backups"

#. Plugin URI of the plugin
#: zinn-backups.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-backups"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-backups"

#. Description of the plugin
#: zinn-backups.php
msgid "Backs up your WordPress files and database to your own storage — Dropbox, Google Drive, Cloudflare R2, Amazon S3 or any S3-compatible bucket — restores them in one go, and imports backups made by other backup and migration plugins."
msgstr "Нусхаҳои эҳтиётии файлҳо ва пойгоҳи додаҳои WordPress-и шуморо дар анбори худатон нигоҳ медорад — Dropbox, Google Drive, Cloudflare R2, Amazon S3 ё ҳама гуна анбори мувофиқ бо S3 — онҳоро якбора барқарор мекунад ва нусхаҳои эҳтиётии бо дигар плагинҳои нусхабардорӣ ва интиқол омодашударо ворид мекунад."

#. Author of the plugin
#: zinn-backups.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-backups.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-admin.php:69
#: includes/class-admin.php:174
msgid "Backups"
msgstr "Нусхаҳои эҳтиётӣ"

#: includes/class-admin.php:73
msgid "Get Pro: schedules, several storages, encryption"
msgstr "Pro гиред: ҷадвалҳо, якчанд анборҳо, рамзгузорӣ"

#: includes/class-admin.php:110
msgid "Working…"
msgstr "Иҷро шуда истодааст…"

#: includes/class-admin.php:111
#: includes/class-admin.php:345
