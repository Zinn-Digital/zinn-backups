#: includes/class-admin.php:127
#, php-format
msgid "Uploading %1$s: %2$s%%"
msgstr "Боркунии %1$s: %2$s%%"

#: includes/class-admin.php:128
msgid "Sign in to Dropbox in the window that opened, then paste the code Dropbox shows you:"
msgstr "Дар равзанаи кушодашуда ба Dropbox ворид шавед, сипас кодеро, ки Dropbox ба шумо нишон медиҳад, гузоред:"

#: includes/class-admin.php:129
msgid "Saved."
msgstr "Сабт шуд."

#: includes/class-admin.php:130
msgid "Remove this destination from the plugin? The backups stored in it are not deleted."
msgstr "Ин макон аз плагин нест карда шавад? Нусхаҳои эҳтиётии дар он маҳфузбуда нест намешаванд."

#: includes/class-admin.php:131
msgid "Reload the page to see the restored site."
msgstr "Барои дидани сайти барқароршуда, саҳифаро аз нав бор кунед."

#: includes/class-admin.php:175
msgid "Storage"
msgstr "Анбор"

#: includes/class-admin.php:176
msgid "Import & migrate"
msgstr "Воридот ва интиқол"

#: includes/class-admin.php:177
msgid "Settings"
msgstr "Танзимот"

#: includes/class-admin.php:203
msgid "Sections"
msgstr "Бахшҳо"

#: includes/class-admin.php:251
msgid "Google Drive is connected."
msgstr "Google Drive пайваст аст."

#: includes/class-admin.php:255
msgid "Google Drive could not be connected."
msgstr "Google Drive пайваст нашуд."

#: includes/class-admin.php:270
msgid "Details"
msgstr "Тафсилот"

#: includes/class-admin.php:283
#: includes/class-admin.php:302
msgid "Back up now"
msgstr "Ҳоло нусхабардорӣ кунед"

#. translators: %s: link to the Storage tab.
#: includes/class-admin.php:288
#, php-format
msgid "Backups go to your own storage, not this server. <a href=\"%s\">Connect your storage</a> first."
msgstr "Нусхаҳои эҳтиётӣ ба анбори худи шумо мераванд, на ба ин сервер. Аввал <a href=\"%s\">анбори худро пайваст кунед</a>."

#: includes/class-admin.php:296
msgid "What to back up"
msgstr "Чиро нусхабардорӣ кардан лозим аст"

#: includes/class-admin.php:297
#: includes/class-admin.php:313
#: includes/class-admin.php:456
msgid "Files and database"
msgstr "Файлҳо ва пойгоҳи додаҳо"

#: includes/class-admin.php:298
#: includes/class-admin.php:313
#: includes/class-admin.php:456
msgid "Database only"
msgstr "Танҳо пойгоҳи додаҳо"

#: includes/class-admin.php:299
#: includes/class-admin.php:313
#: includes/class-admin.php:456
msgid "Files only"
msgstr "Танҳо файлҳо"

#: includes/class-admin.php:301
msgid "Note (optional)"
msgstr "Эзоҳ (ихтиёрӣ)"

#: includes/class-admin.php:304
msgid "Each part is uploaded to your storage and removed from this server before the next one is made, so the backup never takes up room on your hosting."
msgstr "Ҳар як қисм пеш аз сохтани қисми навбатӣ ба анбори шумо бор карда шуда, аз ин сервер нест карда мешавад, бинобар ин нусхаи эҳтиётӣ ҳеҷ гоҳ дар хостинги шумо ҷой намегирад."

#: includes/class-admin.php:307
msgid "Your backups"
msgstr "Нусхаҳои эҳтиётии шумо"

#: includes/class-admin.php:307
msgid "Refresh"
msgstr "Бозсозӣ"

#: includes/class-admin.php:311
msgid "Restore this backup"
msgstr "Ин нусхаи эҳтиётиро барқарор кунед"

#: includes/class-admin.php:314
msgid "Passphrase"
msgstr "Ибораи гузарвожа"

#: includes/class-admin.php:315
msgid "I understand this replaces this site’s files and database with the backup’s. Files that are not in the backup are kept."
msgstr "Ман мефаҳмам, ки ин амал файлҳо ва пойгоҳи додаҳои ин сомонаро бо файлҳо ва пойгоҳи додаҳои нусхаи эҳтиётӣ иваз мекунад. Файлҳое, ки дар нусхаи эҳтиётӣ нестанд, нигоҳ дошта мешаванд."

#: includes/class-admin.php:321
msgid "Recent activity"
msgstr "Фаъолияти охирин"

#: includes/class-admin.php:327
#: includes/class-backup-job.php:104
msgid "Backup"
msgstr "Нусхаи эҳтиётӣ"

#: includes/class-admin.php:327
msgid "Restore / import"
msgstr "Барқароркунӣ / воридот"

#: includes/class-admin.php:348
msgid "Running"
msgstr "Дар ҳоли иҷро"

#: includes/class-admin.php:360
msgid "Your storage"
msgid_plural "Your storage destinations"
msgstr[0] "Анбори шумо"

#: includes/class-admin.php:362
msgid "No storage yet. Choose where your backups go below."
msgstr "Ҳанӯз анборе нест. Дар зер интихоб кунед, ки нусхаҳои эҳтиётии шумо ба куҷо мераванд."

#: includes/class-admin.php:372
msgid "Ready"
msgstr "Омода"

#: includes/class-admin.php:372
msgid "Not connected"
msgstr "Пайваст нест"

#: includes/class-admin.php:373
msgid "Connect"
msgstr "Пайваст шавед"

#: includes/class-admin.php:374
msgid "Test"
msgstr "Санҷиш"

#: includes/class-admin.php:375
msgid "Edit"
msgstr "Вироиш"

#: includes/class-admin.php:376
msgid "Remove"
msgstr "Нест кардан"

#: includes/class-admin.php:382
msgid "Add storage"
msgstr "Илова кардани анборгоҳ"

#: includes/class-admin.php:386
msgid "Backups go to one storage destination. To use a different one, edit or remove the one above."
msgstr "Нусхаҳои эҳтиётӣ ба як макони нигоҳдорӣ мераванд. Барои истифодаи дигараш, маълумоти болоро таҳрир кунед ё нест намоед."

#: includes/class-admin.php:397
msgid "Kind of storage"
msgstr "Навъи захирагоҳ"

#: includes/class-admin.php:402
msgid "Name (for you)"
msgstr "Ном (барои шумо)"

#: includes/class-admin.php:404
msgid "Provider"
msgstr "Провайдер"

#: includes/class-admin.php:409
msgid "Cloudflare account id"
msgstr "ID-и ҳисоби Cloudflare"

#: includes/class-admin.php:410
msgid "Endpoint address"
msgstr "Суроғаи нуқтаи ниҳоӣ"

#: includes/class-admin.php:411
msgid "Region"
msgstr "Минтақа"

#: includes/class-admin.php:412
msgid "Bucket"
msgstr "Бакет"

#: includes/class-admin.php:413
msgid "Access key id"
msgstr "Идентификатори калиди дастрасӣ"

#: includes/class-admin.php:414
msgid "Secret access key"
msgstr "Калиди дастрасии махфӣ"

#: includes/class-admin.php:414
msgid "Leave empty to keep the saved key"
msgstr "Барои нигоҳ доштани калиди сабтшуда холӣ гузоред"

#: includes/class-admin.php:415
msgid "For Cloudflare R2: in the Cloudflare dashboard open R2, create a bucket, then “Manage R2 API tokens” → create a token with Object Read & Write for that bucket, and copy the access key id and secret here."
msgstr "Барои Cloudflare R2: дар панели идораи Cloudflare R2-ро кушоед, сатил (bucket) созед, сипас ба “Manage R2 API tokens” гузаред → барои он сатил нишонае бо иҷозати Object Read & Write созед ва шиносаи калиди дастрасӣ (access key id) ва калиди махфиро ба ин ҷо нусхабардорӣ намоед."

#: includes/class-admin.php:418
msgid "Dropbox app key"
msgstr "Калиди барномаи Dropbox"

#: includes/class-admin.php:419
msgid "Create an app at dropbox.com/developers/apps (Scoped access, App folder) with the files.content.read, files.content.write and files.metadata.read permissions, and copy its App key here. Save, then press Connect."
msgstr "Дар dropbox.com/developers/apps (Scoped access, App folder) бо иҷозатҳои files.content.read, files.content.write ва files.metadata.read як барнома созед ва App key-и онро ба ин ҷо нусхабардорӣ кунед. Сабт кунед, сипас Пайваст карданро зер кунед."

#: includes/class-admin.php:421
msgid "OAuth client id"
msgstr "ID-и мизоҷи OAuth"

#: includes/class-admin.php:422
msgid "OAuth client secret"
msgstr "Сирри мизоҷи OAuth"

#: includes/class-admin.php:422
msgid "Leave empty to keep the saved secret"
msgstr "Барои нигоҳ доштани сирри захирашуда холӣ гузоред"

#: includes/class-admin.php:423
msgid "In Google Cloud Console, enable the Google Drive API, then create an OAuth client of type “Web application” with this address as an authorised redirect URI:"
msgstr "Дар Google Cloud Console, Google Drive API-ро фаъол созед, сипас муштарии OAuth-и намуди «Web application»-ро бо ин нишонӣ ҳамчун URI-и ваколатдори боздиҳӣ эҷод кунед:"

#: includes/class-admin.php:423
msgid "Save, then press Connect. The plugin only sees the files it creates."
msgstr "Захира кунед ва сипас «Пайваст шудан»-ро пахш намоед. Васлкунак танҳо файлҳоеро мебинад, ки худаш эҷод кардааст."

#: includes/class-admin.php:425
msgid "Folder inside the storage (optional)"
msgstr "Ҷузвдони дохили анбор (ихтиёрӣ)"

#: includes/class-admin.php:426
msgid "Save storage"
msgstr "Сарфаи фазои нигоҳдорӣ"

#: includes/class-admin.php:436
msgid "Import a backup from another plugin or host"
msgstr "Воридоти нусхаи эҳтиётӣ аз дигар васлкунак ё мизбон"

#: includes/class-admin.php:437
msgid "Bring a site in from a backup made by UpdraftPlus, All-in-One WP Migration (.wpress), Duplicator (zip), BackWPup, WPvivid, Jetpack VaultPress Backup, BlogVault, Zinn® Migrate, or any zip/tar archive of a WordPress site with its .sql dump. The content goes into wp-content and the database replaces this site’s; addresses are changed to this site’s automatically."
msgstr "Сомонаро аз нусхаи эҳтиётие, ки тавассути UpdraftPlus, All-in-One WP Migration (.wpress), Duplicator (zip), BackWPup, WPvivid, Jetpack VaultPress Backup, BlogVault, Zinn® Migrate ё дигар архиви zip/tar-и сомонаи WordPress бо партови .sql-и он сохта шудааст, ворид кунед. Мундариҷа ба wp-content ворид мешавад ва пойгоҳи додаҳо пойгоҳи додаҳои ин сомонаро иваз мекунад; суроғаҳо ба таври худкор ба суроғаҳои ин сомона иваз карда мешаванд."

#: includes/class-admin.php:439
msgid "Upload from your computer"
msgstr "Аз компютери худ боргузорӣ кунед"

#: includes/class-admin.php:439
msgid "Choose every file of the backup at once (UpdraftPlus makes several). Large files are sent in small pieces, so your host’s upload limit does not apply."
msgstr "Ҳамаи файлҳои нусхаи эҳтиётиро якбора интихоб кунед (UpdraftPlus якчанд файл эҷод мекунад). Файлҳои калон қисм-қисм фиристода мешаванд, бинобар ин маҳдудияти боркунии хостинги шумо татбиқ намегардад."

#: includes/class-admin.php:440
msgid "Or from links (Google Drive, Dropbox or any download address)"
msgstr "Ё аз пайвандҳо (Google Drive, Dropbox ё дигар нишонии боргирӣ)"

#: includes/class-admin.php:440
msgid "One link per line. For Google Drive and Dropbox, share the file with “anyone with the link” and paste that link; turn sharing off again afterwards."
msgstr "Дар ҳар сатр як пайванд. Барои Google Drive ва Dropbox, файлро бо «ҳар касе, ки пайванд дорад» мубодила кунед ва он пайвандро гузоред; пас аз он мубодиларо дубора хомӯш кунед."

#: includes/class-admin.php:442
msgid "Or a file already on this server"
msgstr "Ё файле, ки аллакай дар ин сервер мавҷуд аст"

#. translators: %s: folder path.
#: includes/class-admin.php:450
#, php-format
msgid "Upload archives by FTP or your host’s file manager into %s and reload this page."
msgstr "Бойгониҳоро тавассути FTP ё мудири файлҳои мизбони худ ба %s боргузорӣ намоед ва ин саҳифаро аз нав бор кунед."

#: includes/class-admin.php:455
msgid "Or a deploy code from another site"
msgstr "Ё коди ҷойгиркунӣ аз сомонаи дигар"

#: includes/class-admin.php:455
msgid "If another site gave you a Zinn® Backups deploy code, paste it here to copy that backup onto this site without sharing its storage keys. A code works for a few hours; treat it like a password."
msgstr "Агар сомонаи дигар ба Шумо рамзи густариши Zinn® Backups-ро дода бошад, онро дар ин ҷо гузоред, то он нусхаи эҳтиётиро бе мубодилаи калидҳои нигоҳдории он ба ин сомона нусхабардорӣ кунед. Рамз танҳо чанд соат кор мекунад; бо он мисли парол муносибат кунед."

#: includes/class-admin.php:455
msgid "Passphrase (only if that backup is encrypted)"
msgstr "Ибораи рамзӣ (танҳо дар сурате, ки он нусхаи эҳтиётӣ рамзгузорӣ шуда бошад)"

#: includes/class-admin.php:456
#: includes/class-admin.php:458
msgid "Import"
msgstr "Воридот"

#: includes/class-admin.php:457
msgid "I understand the import replaces this site’s content and database. After it, sign in with an account from the imported site."
msgstr "Ман мефаҳмам, ки воридот муҳтаво ва пойгоҳи додаҳои ин сомонаро иваз мекунад. Пас аз он, бо ҳисоби сомонаи воридшуда ворид шавед."

#: includes/class-admin.php:460
msgid "Moving to Zinn® hosting?"
msgstr "Ба хостинги Zinn® мегузаред?"

#: includes/class-admin.php:460
msgid "Zinn Digital® can move your site for you from your old host. If your old host gives you no FTP, SSH or control-panel access, install Zinn® Migrate on the old site; it makes one archive you can import here or hand to Zinn®."
msgstr "Zinn Digital® метавонад сомонаи шуморо аз мизбони пешинаатон кӯчонад. Агар мизбони пешина ба шумо дастрасӣ ба FTP, SSH ё панели идоракуниро надиҳад, Zinn® Migrate-ро дар сомонаи пешина насб кунед; он як бойгоние месозад, ки шумо метавонед онро дар ин ҷо ворид кунед ё ба Zinn® супоред."

#: includes/class-admin.php:470
msgid "What goes into a backup"
msgstr "Ба нусхаи эҳтиётӣ чӣ дохил мешавад"

#: includes/class-admin.php:471
msgid "Include WordPress’s own files (wp-admin, wp-includes). Usually not needed: WordPress can always be reinstalled."
msgstr "Файлҳои худи WordPress-ро дохил кунед (wp-admin, wp-includes). Одатан лозим нест: WordPress-ро ҳамеша метавон аз нав насб кард."

#: includes/class-admin.php:472
msgid "Also leave out these folders or files (one per line, relative to the WordPress folder)"
msgstr "Инчунин ин ҷузвдонҳо ё файлҳоро сарфи назар кунед (дар як сатр яктогӣ, нисбат ба ҷузвдони WordPress)"

#: includes/class-admin.php:473
msgid "Always left out: caches, update scratch space, and other backup plugins’ own archive folders:"
msgstr "Ҳамеша истисно мешаванд: кэшҳо, фазои муваққатии навсозӣ ва ҷузвдонҳои бойгонии худи дигар васлкунакҳои нусхабардорӣ:"

#: includes/class-admin.php:474
msgid "Size of each part (MB)"
msgstr "Андозаи ҳар як қисм (МБ)"

#: includes/class-admin.php:479
msgid "Save settings"
msgstr "Танзимотро сабт кунед"

#: includes/class-archiver.php:52
msgid "A backup part could not be opened for writing. Check that wp-content has free space."
msgstr "Қисме аз нусхаи эҳтиётӣ барои сабт кушода нашуд. Санҷед, ки оё дар wp-content фазои холӣ мавҷуд аст."

#: includes/class-archiver.php:113
msgid "A backup part could not be written. Check that wp-content has free space."
msgstr "Қисми нусхаи эҳтиётӣ сабт нашуд. Санҷед, ки оё дар wp-content ҷои холӣ ҳаст ё на."

#: includes/class-backup-job.php:42
msgid "Connect a storage destination on the Storage tab first: backups are kept in your own storage, not on this server."
msgstr "Аввал макони таъиноти нигоҳдориро дар ҷадвали Storage пайваст кунед: нусхаҳои эҳтиётӣ дар анбори худи шумо нигоҳ дошта мешаванд, на дар ин сервер."

#: includes/class-backup-job.php:45
#: includes/class-restore-job.php:108
msgid "Multisite networks are not supported yet."
msgstr "Шабакаҳои бисёрсойта (multisite) ҳоло дастгирӣ намешаванд."

#: includes/class-backup-job.php:48
msgid "This server’s PHP has no ZipArchive extension. Ask your host to enable it."
msgstr "PHP-и ин сервер васеъшавии ZipArchive надорад. Аз хостинги худ хоҳиш кунед, ки онро фаъол созад."

#: includes/class-backup-job.php:98
msgid "Starting"
msgstr "Дар ҳоли оғоз"

#: includes/class-backup-job.php:99
msgid "Listing files"
msgstr "Рӯйхат кардани файлҳо"

#: includes/class-backup-job.php:100
msgid "Backing up the database"
msgstr "Нусхабардории эҳтиётии пойгоҳи додаҳо"

#: includes/class-backup-job.php:101
msgid "Packing files"
msgstr "Байстабандии файлҳо"

#: includes/class-backup-job.php:102
msgid "Uploading to your storage"
msgstr "Дар ҳоли боргузорӣ ба захирагоҳи шумо"

#: includes/class-backup-job.php:103
msgid "Finishing"
msgstr "Анҷом ёфта истодааст"

#: includes/class-backup-job.php:123
msgid "The backup reached an unknown stage."
