#, php-format
msgid "Upload archives by FTP or your host’s file manager into %s and reload this page."
msgstr "এফটিপি অথবা আপনার হোস্টের ফাইল ম্যানেজারের মাধ্যমে %s-এ আর্কাইভ আপলোড করুন এবং এই পৃষ্ঠাটি রিলোড করুন।"

#: includes/class-admin.php:455
msgid "Or a deploy code from another site"
msgstr "অথবা অন্য কোনো সাইট থেকে একটি ডিপ্লয় কোড"

#: includes/class-admin.php:455
msgid "If another site gave you a Zinn® Backups deploy code, paste it here to copy that backup onto this site without sharing its storage keys. A code works for a few hours; treat it like a password."
msgstr "অন্য কোনো সাইট আপনাকে একটি Zinn® Backups ডিপ্লয় কোড দিয়ে থাকলে, সেটির স্টোরেজ কী শেয়ার না করেই ব্যাকআপটি এই সাইটে কপি করতে এখানে পেস্ট করুন। একটি কোড কয়েক ঘণ্টার জন্য কাজ করে; এটিকে পাসওয়ার্ডের মতো বিবেচনা করুন।"

#: includes/class-admin.php:455
msgid "Passphrase (only if that backup is encrypted)"
msgstr "পাসফ্রেজ (কেবলমাত্র যদি সেই ব্যাকআপটি এনক্রিপ্ট করা থাকে)"

#: includes/class-admin.php:456
#: includes/class-admin.php:458
msgid "Import"
msgstr "ইমপোর্ট করুন"

#: includes/class-admin.php:457
msgid "I understand the import replaces this site’s content and database. After it, sign in with an account from the imported site."
msgstr "আমি বুঝতে পেরেছি যে আমদানি এই সাইটের বিষয়বস্তু এবং ডেটাবেস প্রতিস্থাপন করে। এর পরে, আমদানিকৃত সাইটের একটি অ্যাকাউন্ট দিয়ে সাইন ইন করুন।"

#: includes/class-admin.php:460
msgid "Moving to Zinn® hosting?"
msgstr "Zinn® হোস্টিংয়ে আসছেন?"

#: includes/class-admin.php:460
msgid "Zinn Digital® can move your site for you from your old host. If your old host gives you no FTP, SSH or control-panel access, install Zinn® Migrate on the old site; it makes one archive you can import here or hand to Zinn®."
msgstr "Zinn Digital® আপনার পুরনো হোস্ট থেকে আপনার সাইট আপনার জন্য স্থানান্তর করতে পারে। আপনার পুরনো হোস্ট যদি আপনাকে FTP, SSH বা কন্ট্রোল-প্যানেল অ্যাক্সেস না দেয়, তবে পুরনো সাইটে Zinn® Migrate ইনস্টল করুন; এটি একটি আর্কাইভ তৈরি করে যা আপনি এখানে আমদানি করতে পারেন বা Zinn®-এর কাছে হস্তান্তর করতে পারেন।"

#: includes/class-admin.php:470
