msgid "Backups go to one storage destination. To use a different one, edit or remove the one above."
msgstr "Napupunta ang mga backup sa iisang imbakan. Para gumamit ng iba, i-edit o alisin ang nasa itaas."

#: includes/class-admin.php:400
msgid "Kind of storage"
msgstr "Uri ng storage"

#: includes/class-admin.php:405
msgid "Name (for you)"
msgstr "Pangalan (para sa iyo)"

#: includes/class-admin.php:407
msgid "Provider"
msgstr "Provider"

#: includes/class-admin.php:412
msgid "Cloudflare account id"
msgstr "ID ng Cloudflare account"

#: includes/class-admin.php:413
msgid "Endpoint address"
msgstr "Address ng endpoint"

#: includes/class-admin.php:414
