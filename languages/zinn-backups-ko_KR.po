msgstr "%1$s 업로드 중: %2$s%%"

#: includes/class-admin.php:128
msgid "Sign in to Dropbox in the window that opened, then paste the code Dropbox shows you:"
msgstr "열린 창에서 Dropbox에 로그인한 다음 Dropbox에 표시된 코드를 붙여넣으세요:"

#: includes/class-admin.php:129
msgid "Saved."
msgstr "저장되었습니다."

#: includes/class-admin.php:130
msgid "Remove this destination from the plugin? The backups stored in it are not deleted."
msgstr "이 대상을 플러그인에서 제거하시겠습니까? 여기에 저장된 백업은 삭제되지 않습니다."

#: includes/class-admin.php:131
msgid "Reload the page to see the restored site."
msgstr "복원된 사이트를 확인하려면 페이지를 새로고침하세요."

#: includes/class-admin.php:175
msgid "Storage"
msgstr "저장 공간"

#: includes/class-admin.php:176
