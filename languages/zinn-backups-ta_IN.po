#, php-format
msgid "Imported %1$s files into wp-content (%2$s left out: caches, drop-ins and other backup plugins’ folders)."
msgstr "wp-content இல் %1$s கோப்புகள் இறக்குமதி செய்யப்பட்டன (%2$s தவிர்க்கப்பட்டன: தற்காலிகச் சேமிப்புகள் (caches), drop-ins மற்றும் பிற காப்புநகல் செருகுநிரல்களின் கோப்புறைகள்)."

#: includes/class-restore-job.php:588
msgid "The archive has no database dump, so only files were imported."
msgstr "காப்பகத்தில் தரவுத்தள டம்ப் இல்லை, எனவே கோப்புகள் மட்டுமே இறக்குமதி செய்யப்பட்டன."

#. translators: %d: number of tables.
#: includes/class-restore-job.php:598
#, php-format
msgid "Database restored into %d temporary tables."
msgstr "தரவுத்தளம் %d தற்காலிக அட்டவணைகளில் மீட்டமைக்கப்பட்டது."

#. translators: %s: file name.
#: includes/class-restore-job.php:615
#, php-format
msgid "%s has no WordPress tables in it and was skipped."
msgstr "%s-ல் எந்த WordPress அட்டவணைகளும் இல்லை, எனவே தவிர்க்கப்பட்டது."

#: includes/class-restore-job.php:653
#: includes/class-table-swap.php:237
msgid "The backup’s database has no WordPress tables, so nothing was replaced."
msgstr "காப்புப்பிரதியின் தரவுத்தளத்தில் WordPress அட்டவணைகள் எதுவும் இல்லை, எனவே எதுவும் மாற்றப்படவில்லை."

#: includes/class-restore-job.php:658
msgid "This backup is of a multisite network. Restoring a network into a single site is not supported."
