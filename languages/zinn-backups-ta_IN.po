msgstr "%s என்பது எங்களால் படிக்கக்கூடிய காப்பு காப்பகம் அல்ல (zip, tar, tar.gz, .wpress, .sql அல்லது .sql.gz)."

#: includes/import/class-formats.php:99
msgid "Website archive"
msgstr "வலைத்தளக் காப்பகம்"

#. translators: %s: file name.
#: includes/import/class-formats.php:123
#, php-format
msgid "%s has no WordPress content (no wp-content folder and no database dump) in it."
msgstr "%s-இல் எந்த WordPress உள்ளடக்கமும் இல்லை (wp-content கோப்புறை மற்றும் தரவுத்தள டம்ப் இல்லை)."

#: includes/import/class-formats.php:155
msgid "This .wpress file is encrypted or compressed by All-in-One WP Migration. Export it again with encryption and compression switched off, then import that."
msgstr "இந்த .wpress கோப்பு All-in-One WP Migration மூலம் என்க்ரிப்ட் அல்லது சுருக்கப்பட்டுள்ளது. என்க்ரிப்ஷன் மற்றும் சுருக்கத்தை முடக்கிவிட்டு மீண்டும் ஏற்றுமதி செய்யவும், பின்னர் அதை இறக்குமதி செய்யவும்."

