#. translators: 1: old address, 2: this site's address.
#: includes/class-restore-job.php:683
#, php-format
msgid "Moving the content from %1$s to %2$s."
msgstr "%1$s இலிருந்து %2$s இற்கு உள்ளடக்கத்தை நகர்த்துகிறது."

#: includes/class-restore-job.php:809
msgid "Restore complete. If you are signed out, sign in with an account from the restored site."
msgstr "மீட்டமைப்பு முடிந்தது. நீங்கள் வெளியேறியிருந்தால், மீட்டமைக்கப்பட்ட தளத்தின் கணக்கைக் கொண்டு உள்நுழையவும்."

#: includes/class-restore-job.php:810
msgid "Restore complete."
msgstr "மீட்டமைத்தல் முடிந்தது."

#. translators: 1: error message, 2: seconds until the retry.
#: includes/class-runner.php:160
#, php-format
msgid "%1$s — trying again in %2$d seconds."
msgstr "%1$s — %2$d வினாடிகளில் மீண்டும் முயற்சிக்கிறது."

#: includes/class-runner.php:189
msgid "Cancelled."
msgstr "ரத்துசெய்யப்பட்டது."

#: includes/class-settings.php:145
msgid "Backups go to one storage destination. Edit or remove the one you have to use a different one."
msgstr "காப்புப்பிரதிகள் ஒரு சேமிப்பக இலக்கிற்குச் செல்கின்றன. வேறு ஒன்றைப் பயன்படுத்த உங்களிடம் உள்ளதைத் திருத்தவும் அல்லது அகற்றவும்."

#: includes/class-sql-importer.php:84
msgid "The database file could not be opened."
