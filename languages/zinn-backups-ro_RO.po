msgstr[2] "Destinațiile tale de stocare"

#: includes/class-admin.php:362
msgid "No storage yet. Choose where your backups go below."
msgstr "Nu există încă spațiu de stocare. Alege mai jos unde merg copiile tale de rezervă."

#: includes/class-admin.php:372
msgid "Ready"
msgstr "Gata"

#: includes/class-admin.php:372
