#: includes/class-admin.php:116
msgid "Delete"
msgstr "हटाएं"

#: includes/class-admin.php:117
msgid "Delete this backup from your storage? This cannot be undone."
msgstr "क्या आप इस बैकअप को अपने स्टोरेज से हटाना चाहते हैं? यह क्रिया पूर्ववत नहीं की जा सकती।"

#: includes/class-admin.php:118
msgid "No backups yet. Press “Back up now” to make the first one."
msgstr "अभी तक कोई बैकअप नहीं है। पहला बैकअप बनाने के लिए \"अभी बैकअप लें\" दबाएं।"

#: includes/class-admin.php:119
msgid "Reading your storage…"
msgstr "आपका स्टोरेज पढ़ा जा रहा है…"

#: includes/class-admin.php:120
msgctxt "a complete backup, as opposed to an incremental one"
msgid "Full backup"
msgstr "पूर्ण बैकअप"

#: includes/class-admin.php:121
msgctxt "a backup holding only what changed since an earlier one"
msgid "Incremental backup"
msgstr "इंक्रीमेंटल बैकअप"

#: includes/class-admin.php:122
msgid "Encrypted"
msgstr "एन्क्रिप्टेड"

#: includes/class-admin.php:123
msgid "From another site"
msgstr "किसी अन्य साइट से"

#: includes/class-admin.php:124
msgid "Database"
msgstr "डेटाबेस"

#: includes/class-admin.php:125
msgid "Files"
