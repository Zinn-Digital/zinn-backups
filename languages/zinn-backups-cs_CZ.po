msgstr "Odebrat toto cílové umístění z pluginu? Zálohy v něm uložené nebudou smazány."

#: includes/class-admin.php:131
msgid "Reload the page to see the restored site."
msgstr "Obnovte stránku, abyste viděli obnovený web."

#: includes/class-admin.php:175
msgid "Storage"
msgstr "Úložiště"

