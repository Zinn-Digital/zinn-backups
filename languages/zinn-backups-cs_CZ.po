msgstr "Zálohovat nyní"

#. translators: %s: link to the Storage tab.
#: includes/class-admin.php:288
#, php-format
msgid "Backups go to your own storage, not this server. <a href=\"%s\">Connect your storage</a> first."
msgstr "Zálohy se ukládají do vašeho vlastního úložiště, nikoli na tento server. Nejprve <a href=\"%s\">připojte své úložiště</a>."

#: includes/class-admin.php:296
msgid "What to back up"
msgstr "Co zálohovat"

#: includes/class-admin.php:297
#: includes/class-admin.php:313
#: includes/class-admin.php:456
msgid "Files and database"
msgstr "Soubory a databáze"

#: includes/class-admin.php:298
#: includes/class-admin.php:313
#: includes/class-admin.php:456
msgid "Database only"
msgstr "Pouze databáze"

#: includes/class-admin.php:299
#: includes/class-admin.php:313
#: includes/class-admin.php:456
msgid "Files only"
msgstr "Pouze soubory"

#: includes/class-admin.php:301
msgid "Note (optional)"
msgstr "Poznámka (volitelné)"

#: includes/class-admin.php:304
msgid "Each part is uploaded to your storage and removed from this server before the next one is made, so the backup never takes up room on your hosting."
msgstr "Každá část se nahraje do vašeho úložiště a odstraní z tohoto serveru ještě před vytvořením další části, takže záloha nikdy nezabírá místo na vašem hostingu."

#: includes/class-admin.php:307
msgid "Your backups"
msgstr "Vaše zálohy"

#: includes/class-admin.php:307
msgid "Refresh"
msgstr "Obnovit"

#: includes/class-admin.php:311
msgid "Restore this backup"
msgstr "Obnovit tuto zálohu"

#: includes/class-admin.php:314
msgid "Passphrase"
msgstr "Přístupové heslo"

#: includes/class-admin.php:315
msgid "I understand this replaces this site’s files and database with the backup’s. Files that are not in the backup are kept."
msgstr "Rozumím tomu, že tímto dojde k nahrazení souborů a databáze tohoto webu zálohou. Soubory, které nejsou v záloze, zůstanou zachovány."

#: includes/class-admin.php:321
msgid "Recent activity"
msgstr "Nedávná aktivita"

#: includes/class-admin.php:327
#: includes/class-backup-job.php:104
msgid "Backup"
msgstr "Záloha"

#: includes/class-admin.php:327
msgid "Restore / import"
msgstr "Obnovit / importovat"

#: includes/class-admin.php:348
msgid "Running"
msgstr "Spuštěno"

#: includes/class-admin.php:360
msgid "Your storage"
msgid_plural "Your storage destinations"
msgstr[0] "Vaše úložiště"
msgstr[1] "Vaše úložiště"
msgstr[2] "Vaše úložiště"
msgstr[3] "Vaše úložiště"

#: includes/class-admin.php:362
msgid "No storage yet. Choose where your backups go below."
msgstr "Zatím žádné úložiště. Níže vyberte, kam se mají ukládat vaše zálohy."

#: includes/class-admin.php:372
msgid "Ready"
msgstr "Připraveno"

#: includes/class-admin.php:372
msgid "Not connected"
msgstr "Nepřipojeno"

#: includes/class-admin.php:373
msgid "Connect"
msgstr "Připojit"

#: includes/class-admin.php:374
msgid "Test"
msgstr "Test"

#: includes/class-admin.php:375
msgid "Edit"
msgstr "Upravit"

#: includes/class-admin.php:376
msgid "Remove"
msgstr "Odstranit"

#: includes/class-admin.php:382
msgid "Add storage"
msgstr "Přidat úložiště"

#: includes/class-admin.php:386
msgid "Backups go to one storage destination. To use a different one, edit or remove the one above."
msgstr "Zálohy směřují do jednoho cílového úložiště. Chcete-li použít jiné, upravte nebo odeberte to výše."

#: includes/class-admin.php:397
msgid "Kind of storage"
msgstr "Druh úložiště"

#: includes/class-admin.php:402
msgid "Name (for you)"
msgstr "Název (pro vás)"

#: includes/class-admin.php:404
msgid "Provider"
msgstr "Poskytovatel"

#: includes/class-admin.php:409
msgid "Cloudflare account id"
msgstr "ID účtu Cloudflare"

#: includes/class-admin.php:410
msgid "Endpoint address"
msgstr "Adresa koncového bodu"

#: includes/class-admin.php:411
msgid "Region"
msgstr "Oblast"

#: includes/class-admin.php:412
msgid "Bucket"
msgstr "Bucket"

#: includes/class-admin.php:413
msgid "Access key id"
msgstr "ID přístupového klíče"

#: includes/class-admin.php:414
msgid "Secret access key"
msgstr "Tajný přístupový klíč"

#: includes/class-admin.php:414
msgid "Leave empty to keep the saved key"
msgstr "Ponechte prázdné pro zachování uloženého klíče"

#: includes/class-admin.php:415
msgid "For Cloudflare R2: in the Cloudflare dashboard open R2, create a bucket, then “Manage R2 API tokens” → create a token with Object Read & Write for that bucket, and copy the access key id and secret here."
msgstr "Pro Cloudflare R2: v nástěnce Cloudflare otevřete R2, vytvořte bucket, poté „Manage R2 API tokens“ → vytvořte token s oprávněním Object Read & Write pro daný bucket a zkopírujte sem access key id a secret."

#: includes/class-admin.php:418
msgid "Dropbox app key"
msgstr "Klíč aplikace Dropbox"

#: includes/class-admin.php:419
msgid "Create an app at dropbox.com/developers/apps (Scoped access, App folder) with the files.content.read, files.content.write and files.metadata.read permissions, and copy its App key here. Save, then press Connect."
msgstr "Vytvořte aplikaci na dropbox.com/developers/apps (Scoped access, App folder) s oprávněními files.content.read, files.content.write a files.metadata.read a zkopírujte sem její App key. Uložte a poté stiskněte Connect."

#: includes/class-admin.php:421
msgid "OAuth client id"
msgstr "ID klienta OAuth"

#: includes/class-admin.php:422
msgid "OAuth client secret"
msgstr "Tajný klíč klienta OAuth"

#: includes/class-admin.php:422
msgid "Leave empty to keep the saved secret"
msgstr "Ponechte prázdné pro zachování uloženého tajného klíče"

#: includes/class-admin.php:423
msgid "In Google Cloud Console, enable the Google Drive API, then create an OAuth client of type “Web application” with this address as an authorised redirect URI:"
msgstr "V Google Cloud Console povolte Google Drive API a poté vytvořte klienta OAuth typu „Web application“ s touto adresou jako autorizovaným identifikátorem URI pro přesměrování:"

#: includes/class-admin.php:423
msgid "Save, then press Connect. The plugin only sees the files it creates."
msgstr "Uložte a poté stiskněte Připojit. Plugin vidí pouze soubory, které sám vytvoří."

#: includes/class-admin.php:425
msgid "Folder inside the storage (optional)"
msgstr "Složka v úložišti (volitelné)"

#: includes/class-admin.php:426
msgid "Save storage"
msgstr "Ušetřit úložiště"

#: includes/class-admin.php:436
msgid "Import a backup from another plugin or host"
msgstr "Importovat zálohu z jiného pluginu nebo hostingu"

#: includes/class-admin.php:437
msgid "Bring a site in from a backup made by UpdraftPlus, All-in-One WP Migration (.wpress), Duplicator (zip), BackWPup, WPvivid, Jetpack VaultPress Backup, BlogVault, Zinn® Migrate, or any zip/tar archive of a WordPress site with its .sql dump. The content goes into wp-content and the database replaces this site’s; addresses are changed to this site’s automatically."
msgstr "Přeneste web ze zálohy vytvořené pomocí UpdraftPlus, All-in-One WP Migration (.wpress), Duplicator (zip), BackWPup, WPvivid, Jetpack VaultPress Backup, BlogVault, Zinn® Migrate nebo z libovolného archivu zip/tar webu WordPress s jeho výpisem .sql. Obsah se přesune do wp-content a databáze nahradí databázi tohoto webu; adresy se automaticky změní na adresy tohoto webu."

#: includes/class-admin.php:439
msgid "Upload from your computer"
msgstr "Nahrát z počítače"

#: includes/class-admin.php:439
msgid "Choose every file of the backup at once (UpdraftPlus makes several). Large files are sent in small pieces, so your host’s upload limit does not apply."
msgstr "Vyberte všechny soubory zálohy najednou (UpdraftPlus jich vytváří několik). Velké soubory se odesílají po malých částech, takže se na ně nevztahuje limit pro nahrávání vašeho hostingu."

#: includes/class-admin.php:440
msgid "Or from links (Google Drive, Dropbox or any download address)"
msgstr "Nebo z odkazů (Google Drive, Dropbox nebo jakákoli adresa pro stažení)"

#: includes/class-admin.php:440
msgid "One link per line. For Google Drive and Dropbox, share the file with “anyone with the link” and paste that link; turn sharing off again afterwards."
msgstr "Jeden odkaz na řádek. Pro Google Drive a Dropbox nasdílejte soubor „komukoli s odkazem“ a vložte tento odkaz; poté sdílení opět vypněte."

#: includes/class-admin.php:442
msgid "Or a file already on this server"
msgstr "Nebo soubor, který se již nachází na tomto serveru"

#. translators: %s: folder path.
#: includes/class-admin.php:450
#, php-format
msgid "Upload archives by FTP or your host’s file manager into %s and reload this page."
msgstr "Nahrajte archivy přes FTP nebo správce souborů vašeho hostingu do %s a znovu načtěte tuto stránku."

#: includes/class-admin.php:455
msgid "Or a deploy code from another site"
msgstr "Nebo kód nasazení z jiného webu"

#: includes/class-admin.php:455
msgid "If another site gave you a Zinn® Backups deploy code, paste it here to copy that backup onto this site without sharing its storage keys. A code works for a few hours; treat it like a password."
msgstr "Pokud vám jiný web poskytl kód nasazení Zinn® Backups, vložte jej sem a zkopírujte tuto zálohu na tento web bez sdílení jejích klíčů úložiště. Kód funguje několik hodin; zacházejte s ním jako s heslem."

#: includes/class-admin.php:455
msgid "Passphrase (only if that backup is encrypted)"
msgstr "Heslová fráze (pouze pokud je tato záloha šifrována)"

#: includes/class-admin.php:456
#: includes/class-admin.php:458
msgid "Import"
msgstr "Importovat"

#: includes/class-admin.php:457
msgid "I understand the import replaces this site’s content and database. After it, sign in with an account from the imported site."
msgstr "Rozumím tomu, že import nahradí obsah a databázi tohoto webu. Poté se přihlaste pomocí účtu z importovaného webu."

#: includes/class-admin.php:460
msgid "Moving to Zinn® hosting?"
msgstr "Převedení hostingu k Zinn®?"

#: includes/class-admin.php:460
msgid "Zinn Digital® can move your site for you from your old host. If your old host gives you no FTP, SSH or control-panel access, install Zinn® Migrate on the old site; it makes one archive you can import here or hand to Zinn®."
msgstr "Zinn Digital® může přesunout váš web z vašeho starého hostingu za vás. Pokud vám váš starý hosting neposkytuje přístup k FTP, SSH nebo ovládacímu panelu, nainstalujte na starý web Zinn® Migrate; vytvoří jeden archiv, který můžete importovat zde nebo předat Zinn®."

#: includes/class-admin.php:470
msgid "What goes into a backup"
msgstr "Co obsahuje záloha"

#: includes/class-admin.php:471
msgid "Include WordPress’s own files (wp-admin, wp-includes). Usually not needed: WordPress can always be reinstalled."
msgstr "Zahrnout vlastní soubory WordPress (wp-admin, wp-includes). Obvykle není potřeba: WordPress lze kdykoli přeinstalovat."

#: includes/class-admin.php:472
msgid "Also leave out these folders or files (one per line, relative to the WordPress folder)"
msgstr "Vynechejte také tyto složky nebo soubory (jeden na řádek, relativně ke složce WordPress)"

#: includes/class-admin.php:473
msgid "Always left out: caches, update scratch space, and other backup plugins’ own archive folders:"
msgstr "Vždy vynecháno: mezipaměti, dočasný prostor pro aktualizace a vlastní archivní složky jiných zálohovacích pluginů:"

#: includes/class-admin.php:474
msgid "Size of each part (MB)"
msgstr "Velikost každé části (MB)"

#: includes/class-admin.php:479
msgid "Save settings"
msgstr "Uložit nastavení"

#: includes/class-archiver.php:52
msgid "A backup part could not be opened for writing. Check that wp-content has free space."
msgstr "Část zálohy se nepodařilo otevřít pro zápis. Zkontrolujte, zda je v adresáři wp-content volné místo."

#: includes/class-archiver.php:113
msgid "A backup part could not be written. Check that wp-content has free space."
msgstr "Část zálohy se nepodařilo zapsat. Zkontrolujte, zda je ve složce wp-content volné místo."

#: includes/class-backup-job.php:42
msgid "Connect a storage destination on the Storage tab first: backups are kept in your own storage, not on this server."
msgstr "Nejprve připojte cílové úložiště na kartě Storage: zálohy se ukládají do vašeho vlastního úložiště, nikoli na tento server."

#: includes/class-backup-job.php:45
#: includes/class-restore-job.php:108
msgid "Multisite networks are not supported yet."
msgstr "Sítě webů (multisite) zatím nejsou podporovány."

#: includes/class-backup-job.php:48
msgid "This server’s PHP has no ZipArchive extension. Ask your host to enable it."
msgstr "PHP na tomto serveru nemá rozšíření ZipArchive. Požádejte svůj hosting o jeho povolení."

#: includes/class-backup-job.php:98
msgid "Starting"
msgstr "Spouštění"

#: includes/class-backup-job.php:99
msgid "Listing files"
msgstr "Vypisování souborů"

#: includes/class-backup-job.php:100
msgid "Backing up the database"
msgstr "Zálohování databáze"

#: includes/class-backup-job.php:101
msgid "Packing files"
msgstr "Balení souborů"

#: includes/class-backup-job.php:102
msgid "Uploading to your storage"
msgstr "Nahrávání do vašeho úložiště"

#: includes/class-backup-job.php:103
msgid "Finishing"
msgstr "Dokončování"

#: includes/class-backup-job.php:123
msgid "The backup reached an unknown stage."
msgstr "Záloha dosáhla neznámé fáze."

#. translators: %s: backup id.
#: includes/class-backup-job.php:143
#, php-format
msgid "Backup %s started."
msgstr "Zálohování %s bylo zahájeno."

#. translators: 1: number of files, 2: total size.
#: includes/class-backup-job.php:168
#, php-format
msgid "Found %1$s files (%2$s)."
msgstr "Nalezeno %1$s souborů (%2$s)."

#. translators: 1: number of tables, 2: number of rows, 3: size.
#: includes/class-backup-job.php:209
#, php-format
msgid "Database: %1$d tables, %2$s rows, %3$s compressed."
msgstr "Databáze: %1$d tabulek, %2$s řádků, %3$s komprimováno."

#. translators: 1: size of the backup, 2: number of destinations.
#: includes/class-backup-job.php:473
#, php-format
msgid "Backup complete: %1$s stored in %2$d destination."
msgid_plural "Backup complete: %1$s stored in %2$d destinations."
msgstr[0] "Záloha dokončena: %1$s uloženo v %2$d cíli."
msgstr[1] "Zálohování dokončeno: %1$s uloženo v %2$d umístěních."
msgstr[2] "Zálohování dokončeno: %1$s uloženo v %2$d umístěních."
msgstr[3] "Zálohování dokončeno: %1$s uloženo v %2$d umístěních."

#: includes/class-backup-job.php:503
msgid "Some parts already uploaded could not be removed from your storage; they are in an incomplete backup folder and are never offered for restore."
msgstr "Některé již nahrané součásti se nepodařilo z vašeho úložiště odstranit; nacházejí se ve složce neúplné zálohy a nikdy nebudou nabídnuty k obnovení."

#: includes/class-backup-job.php:520
msgid "A storage destination was removed while the backup was running."
msgstr "Cílové úložiště bylo odebráno v průběhu zálohování."

#: includes/class-catalog.php:134
msgid "That is not a backup folder."
msgstr "Toto není složka se zálohou."

#: includes/class-catalog.php:138
#: includes/class-restore-job.php:186
msgid "That storage destination is no longer saved on this site."
msgstr "Toto úložiště již není na tomto webu uloženo."

#: includes/class-catalog.php:141
msgid "Later incremental backups are built on this one. Delete those first."
msgstr "Pozdější přírůstkové zálohy jsou postaveny na této. Nejprve odstraňte je."

#: includes/class-crypto.php:88
msgid "This file is not an encrypted Zinn® Backups file."
msgstr "Tento soubor není šifrovaný soubor Zinn® Backups."

#: includes/class-crypto.php:103
msgid "The backup could not be decrypted: the passphrase is wrong or the file is damaged."
msgstr "Zálohu se nepodařilo dešifrovat: heslo je nesprávné nebo je soubor poškozen."

#: includes/class-crypto.php:112
msgid "The encrypted backup file is incomplete."
msgstr "Zašifrovaný soubor zálohy je neúplný."

#: includes/class-database-dumper.php:67
msgid "The database file could not be written. Check that wp-content has free space."
msgstr "Soubor databáze se nepodařilo zapsat. Zkontrolujte, zda má složka wp-content volné místo."

#: includes/class-deploy-code.php:41
msgid "That is not a deploy code. A deploy code starts with zbdeploy1."
msgstr "Toto není kód pro nasazení. Kód pro nasazení začíná na zbdeploy1."

#: includes/class-deploy-code.php:46
#: includes/class-deploy-code.php:67
#: includes/class-deploy-code.php:76
msgid "That deploy code is damaged. Copy it again from the other site."
msgstr "Tento kód pro nasazení je poškozený. Zkopírujte jej znovu z druhého webu."

#: includes/class-deploy-code.php:56
msgid "The deploy code has expired or its backup was deleted. Make a new code on the other site."
msgstr "Platnost nasazovacího kódu vypršela nebo byla smazána jeho záloha. Vytvořte nový kód na druhém webu."

