msgstr "UpdraftPlus-ի տվյալների բազայի այս պահուստային պատճենը կոդավորված է: Վերծանեք այն UpdraftPlus-ում (կամ անջատեք տվյալների բազայի կոդավորումը և նորից կատարեք պահուստավորում), ապա ներմուծեք այն:"

#: includes/import/class-formats.php:76
msgid "Database dump"
msgstr "Տվյալների բազայի դամփ"

#. translators: %s: file name.
#: includes/import/class-formats.php:93
#, php-format
msgid "%s is not a backup archive we can read (zip, tar, tar.gz, .wpress, .sql or .sql.gz)."
msgstr "%s-ը պահուստային արխիվ չէ, որը մենք կարող ենք կարդալ (zip, tar, tar.gz, .wpress, .sql կամ .sql.gz):"

#: includes/import/class-formats.php:99
