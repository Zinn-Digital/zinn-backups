#. translators: 1: size of the backup, 2: number of destinations.
#: includes/class-backup-job.php:473
#, php-format
msgid "Backup complete: %1$s stored in %2$d destination."
msgid_plural "Backup complete: %1$s stored in %2$d destinations."
msgstr[0] "Պահուստավորումն ավարտված է. %1$s պահպանվել է %2$d նպատակակետում:"
msgstr[1] "Պահուստավորումն ավարտված է. %1$s-ը պահպանվել է %2$d ուղղություններում:"

#: includes/class-backup-job.php:503
msgid "Some parts already uploaded could not be removed from your storage; they are in an incomplete backup folder and are never offered for restore."
msgstr "Արդեն վերբեռնված որոշ մասեր հնարավոր չեղավ հեռացնել ձեր պահոցից. դրանք գտնվում են անավարտ պահուստային պատճենման պանակում և երբեք չեն առաջարկվում վերականգնման համար:"

#: includes/class-backup-job.php:520
