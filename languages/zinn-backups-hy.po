#: includes/class-admin.php:301
msgid "Note (optional)"
msgstr "Նշում (կամընտիր)"

#: includes/class-admin.php:304
msgid "Each part is uploaded to your storage and removed from this server before the next one is made, so the backup never takes up room on your hosting."
msgstr "Յուրաքանչյուր մաս վերբեռնվում է ձեր պահոց և հեռացվում այս սերվերից՝ նախքան հաջորդի ստեղծումը, ուստի պահուստային պատճենը երբեք տեղ չի զբաղեցնում ձեր հոսթինգում:"

#: includes/class-admin.php:307
msgid "Your backups"
msgstr "Ձեր պահուստային պատճենները"

#: includes/class-admin.php:307
msgid "Refresh"
msgstr "Թարմացնել"

#: includes/class-admin.php:311
