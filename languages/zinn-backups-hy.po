msgstr "Հեռացնե՞լ այս նպատակակետը փլագինից: Դրանում պահված պահուստային պատճենները չեն ջնջվի:"

#: includes/class-admin.php:131
msgid "Reload the page to see the restored site."
msgstr "Վերաբեռնեք էջը՝ վերականգնված կայքը տեսնելու համար:"

#: includes/class-admin.php:175
msgid "Storage"
msgstr "Պահոց"

#: includes/class-admin.php:176
