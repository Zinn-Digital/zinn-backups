#: includes/class-cli.php:313
#: includes/class-connection-keys.php:182
#: includes/class-settings.php:241
msgid "No destination with that id. See: wp zinn-backups destination list"
msgstr "Այդ նույնացուցիչով նպատակակետ չկա: Տեսեք՝ wp zinn-backups destination list"

#: includes/class-cli.php:391
msgid "Use: wp zinn-backups key set|get|remove [<name>]"
msgstr "Կիրառություն՝ wp zinn-backups key set|get|remove [<name>]"

#: includes/class-cli.php:395
msgid "Do not put a key on the command line. Pipe it in on STDIN, or name an environment variable with --from-env."
msgstr "Մի տեղադրեք բանալին հրամանի տողում: Փոխանցեք այն STDIN-ի միջոցով կամ նշեք միջավայրի փոփոխական --from-env-ով:"

#. translators: 1: key name, 2: destination id, 3: the key with all but its last characters hidden.
#: includes/class-cli.php:414
#, php-format
msgid "Saved %1$s for destination %2$s: %3$s"
msgstr "Պահպանվել է %1$s-ը %2$s նպատակակետի համար՝ %3$s"

#. translators: 1: key name, 2: destination id.
#: includes/class-cli.php:420
#, php-format
msgid "Remove %1$s from destination %2$s? Backups to it stop until a new one is set."
msgstr "Հեռացնե՞լ %1$s-ը %2$s նպատակակետից: Դեպի այն պահուստավորումները կդադարեն, մինչև նորը չսահմանվի:"

#. translators: 1: key name, 2: destination id.
#: includes/class-cli.php:425
#, php-format
msgid "Removed %1$s from destination %2$s."
msgstr "%1$s-ը հեռացվել է %2$s նպատակակետից:"

#: includes/class-cli.php:458
msgid "The loader is in place."
msgstr "Բեռնիչը տեղում է:"

#: includes/class-cli.php:458
msgid "The loader is removed."
msgstr "Բեռնիչը հեռացված է:"

#: includes/class-cli.php:486
msgid "Use: wp zinn-backups loader status|install|remove"
msgstr "Կիրառում՝ wp zinn-backups loader status|install|remove"

#: includes/class-cli.php:504
msgid "That environment variable is not set or is empty."
msgstr "Այդ միջավայրի փոփոխականը սահմանված չէ կամ դատարկ է:"

#. translators: 1: key name typed, 2: the valid key names, comma separated.
#: includes/class-connection-keys.php:107
#, php-format
msgid "This destination has no key called “%1$s”. Its keys: %2$s."
msgstr "Այս նպատակակետը չունի «%1$s» անունով բանալի: Դրա բանալիները՝ %2$s:"

#: includes/class-connection-keys.php:142
msgid "No key was given. Pipe it in on STDIN or name an environment variable with --from-env."
msgstr "Ոչ մի բանալի չի տրամադրվել: Փոխանցեք այն STDIN-ի միջոցով կամ նշեք միջավայրի փոփոխական --from-env-ով:"

#. translators: %s: key name, e.g. secret-key.
#: includes/class-connection-keys.php:148
#, php-format
msgid "That does not look like a valid %s (wrong length, or characters a key of this kind never contains). Nothing was saved."
msgstr "Սա նման չէ վավեր %s-ի (սխալ երկարություն կամ նիշեր, որոնք այս տեսակի բանալին երբեք չի պարունակում): Ոչինչ չի պահպանվել:"

#: includes/class-connection-keys.php:191
msgid "There is no storage destination yet. Add one first: wp zinn-backups destination add"
msgstr "Դեռևս պահպանման վայր չկա: Նախ ավելացրեք մեկը՝ wp zinn-backups destination add"

#: includes/class-connection-keys.php:193
msgid "There is more than one destination: choose one with --id. See: wp zinn-backups destination list"
msgstr "Գոյություն ունի մեկից ավելի նպատակակետ․ ընտրեք մեկը --id-ի միջոցով։ Տե՛ս․ wp zinn-backups destination list"

#: includes/class-connection-keys.php:212
msgid "(not set)"
msgstr "(սահմանված չէ)"

#: includes/class-crypto.php:88
msgid "This file is not an encrypted Zinn® Backups file."
msgstr "Այս ֆայլը կոդավորված Zinn® Backups ֆայլ չէ:"

#: includes/class-crypto.php:103
msgid "The backup could not be decrypted: the passphrase is wrong or the file is damaged."
msgstr "Չհաջողվեց վերծանել պահուստային պատճենը․ գաղտնաբառը սխալ է, կամ ֆայլը վնասված է։"

