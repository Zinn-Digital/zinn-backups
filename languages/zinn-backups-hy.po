msgstr "%1$s-ի վերբեռնում․ %2$s%%"

#: includes/class-admin.php:128
msgid "Sign in to Dropbox in the window that opened, then paste the code Dropbox shows you:"
msgstr "Մուտք գործեք Dropbox բացված պատուհանում, այնուհետև տեղադրեք այն կոդը, որը Dropbox-ը ցույց է տալիս ձեզ."

