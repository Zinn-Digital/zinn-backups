msgstr "Կայքի արխիվ"

#. translators: %s: file name.
#: includes/import/class-formats.php:123
#, php-format
msgid "%s has no WordPress content (no wp-content folder and no database dump) in it."
msgstr "%s-ը չի պարունակում WordPress-ի բովանդակություն (չկա wp-content թղթապանակ և չկա տվյալների բազայի արտահանում):"

#: includes/import/class-formats.php:155
msgid "This .wpress file is encrypted or compressed by All-in-One WP Migration. Export it again with encryption and compression switched off, then import that."
msgstr "Այս .wpress ֆայլը կոդավորված կամ սեղմված է All-in-One WP Migration-ի կողմից: Խնդրում ենք արտահանել այն կրկին՝ անջատված կոդավորմամբ և սեղմմամբ, ապա ներմուծել այն:"

#: includes/storage/class-destinations.php:62
msgid "Other S3-compatible storage"
msgstr "S3-ի հետ համատեղելի այլ պահեստ"

#: includes/storage/class-destinations.php:77
msgid "Cloudflare R2, Amazon S3 or S3-compatible"
msgstr "Cloudflare R2, Amazon S3 կամ S3-ի հետ համատեղելի"

#: includes/storage/class-destinations.php:100
msgid "The storage keys could not be read on this site. Enter the secret key again on the Storage tab."
msgstr "Այս կայքում չհաջողվեց կարդալ պահոցի բանալիները: Կրկին մուտքագրեք գաղտնի բանալին «Պահոց» ներդիրում:"

#: includes/storage/class-destinations.php:116
msgid "This kind of storage is not known."
msgstr "Պահոցի այս տեսակն անհայտ է։"

#: includes/storage/class-destinations.php:168
msgid "Choose a kind of storage."
msgstr "Ընտրեք պահոցի տեսակը:"

#: includes/storage/class-destinations.php:187
msgid "Enter the bucket name and the access key."
msgstr "Մուտքագրեք զամբյուղի անունը և մուտքի բանալին:"

#: includes/storage/class-destinations.php:190
msgid "Enter your Cloudflare account id (or the full R2 endpoint)."
msgstr "Մուտքագրեք ձեր Cloudflare հաշվի նույնացուցիչը (կամ R2-ի ամբողջական վերջնակետը):"

#: includes/storage/class-destinations.php:193
msgid "Enter the endpoint address of your storage."
msgstr "Մուտքագրեք Ձեր պահեստի վերջնակետի հասցեն:"

#: includes/storage/class-destinations.php:202
msgid "Enter the OAuth client id from your Google Cloud project."
msgstr "Մուտքագրեք OAuth client id-ն ձեր Google Cloud նախագծից:"

#: includes/storage/class-dropbox.php:94
msgid "Dropbox did not return a refresh token. Start the connection again."
msgstr "Dropbox-ը չի վերադարձրել թարմացման թոքեն։ Խնդրում ենք նորից սկսել կապը։"

#: includes/storage/class-dropbox.php:369
msgid "Dropbox is not connected. Connect it again on the Storage tab."
msgstr "Dropbox-ը միացված չէ: Կրկին միացրեք այն «Պահեստ» ներդիրում:"

#: includes/storage/class-google-drive.php:114
msgid "Google did not return a refresh token. Remove this site from your Google account’s third-party access and connect again."
msgstr "Google-ը չի վերադարձրել թարմացման տոկեն: Հեռացրեք այս կայքը ձեր Google հաշվի երրորդ կողմի մուտքից և նորից միացեք:"

#: includes/storage/class-google-drive.php:308
msgid "That file is not in Google Drive any more."
msgstr "Այդ ֆայլն այլևս Google Drive-ում չէ։"

#: includes/storage/class-google-drive.php:477
msgid "Google Drive is not connected. Connect it again on the Storage tab."
msgstr "Google Drive-ը միացված չէ: Կրկին միացրեք այն «Պահոց» ներդիրում:"

#: includes/storage/class-s3.php:85
msgid "The storage service did not start the upload."
msgstr "Պահոցային ծառայությունը չսկսեց վերբեռնումը:"

#: includes/storage/class-s3.php:352
msgid "The storage service sent a reply that could not be read."
msgstr "Պահոցի ծառայությունը պատասխան է ուղարկել, որը հնարավոր չէ կարդալ։"

#: includes/storage/class-s3.php:380
msgid "A temporary backup file could not be read."
msgstr "Չհաջողվեց կարդալ պահուստային ժամանակավոր նիշքը:"

#: includes/storage/class-url-source.php:71
msgid "A deploy link is read-only."
msgstr "Տեղակայման հղումը միայն կարդալու համար է:"

#: includes/storage/class-url-source.php:106
msgid "The deploy code has no link for a file this backup needs."
msgstr "Տեղակայման կոդը չունի հղում այն ֆայլի համար, որն անհրաժեշտ է այս պահուստային պատճենին։"

#: includes/storage/class-url-source.php:115
msgid "The deploy link"
msgstr "Տեղակայման հղումը"
