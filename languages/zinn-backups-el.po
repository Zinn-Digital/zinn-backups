#. Plugin Name of the plugin
#: zinn-backups.php
#: includes/class-admin.php:50
msgid "Zinn® Backups"
msgstr "Zinn® Backups"

#. Plugin URI of the plugin
#: zinn-backups.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-backups"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-backups"

#. Description of the plugin
#: zinn-backups.php
msgid "Backs up your WordPress files and database to your own storage — Dropbox, Google Drive, Cloudflare R2, Amazon S3 or any S3-compatible bucket — restores them in one go, and imports backups made by other backup and migration plugins."
msgstr "Δημιουργεί αντίγραφα ασφαλείας των αρχείων και της βάσης δεδομένων του WordPress σας στον δικό σας αποθηκευτικό χώρο — Dropbox, Google Drive, Cloudflare R2, Amazon S3 ή οποιοδήποτε συμβατό με S3 bucket —, τα επαναφέρει με μία κίνηση και εισάγει αντίγραφα ασφαλείας που δημιουργήθηκαν από άλλα πρόσθετα αντιγράφων ασφαλείας και μετεγκατάστασης."

#. Author of the plugin
#: zinn-backups.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-backups.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-admin.php:69
#: includes/class-admin.php:174
msgid "Backups"
msgstr "Αντίγραφα ασφαλείας"

#: includes/class-admin.php:73
msgid "Get Pro: schedules, several storages, encryption"
msgstr "Αποκτήστε το Pro: χρονοδιαγράμματα, πολλαπλοί χώροι αποθήκευσης, κρυπτογράφηση"

#: includes/class-admin.php:110
