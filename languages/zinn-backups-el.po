msgid "The update could not be downloaded from the Zinn® update service (%s). Try again in a few minutes."
msgstr "Δεν ήταν δυνατή η λήψη της ενημέρωσης από την υπηρεσία ενημερώσεων του Zinn® (%s). Δοκιμάστε ξανά σε λίγα λεπτά."

#: includes/class-zinn-backups-updater.php:330
msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Η ληφθείσα ενημέρωση απέτυχε στον έλεγχο ακεραιότητας και δεν εγκαταστάθηκε."

#: includes/import/class-archive-reader.php:147
msgid "The zip archive could not be opened. It may be damaged or incomplete."
msgstr "Δεν ήταν δυνατό το άνοιγμα του συμπιεσμένου αρχείου zip. Ενδέχεται να είναι κατεστραμμένο ή ελλιπές."

#: includes/import/class-archive-reader.php:311
msgid "This .wpress file uses a format we cannot read (it may be compressed or encrypted by All-in-One WP Migration). Export it again without encryption."
msgstr "Αυτό το αρχείο .wpress χρησιμοποιεί μια μορφή που δεν μπορούμε να αναγνώσουμε (ίσως είναι συμπιεσμένο ή κρυπτογραφημένο από το All-in-One WP Migration). Εξαγάγετέ το ξανά χωρίς κρυπτογράφηση."

#: includes/import/class-formats.php:66
msgid "This is a Duplicator “DupArchive” (.daf) file. In Duplicator, build the package again with the archive format set to ZIP, then import that."
msgstr "Αυτό είναι ένα αρχείο Duplicator «DupArchive» (.daf). Στο Duplicator, δημιουργήστε ξανά το πακέτο με τη μορφή αρχειοθέτησης ορισμένη σε ZIP και, στη συνέχεια, εισαγάγετέ το."

#: includes/import/class-formats.php:69
msgid "This UpdraftPlus database backup is encrypted. Decrypt it in UpdraftPlus (or turn off database encryption and back up again), then import it."
msgstr "Αυτό το αντίγραφο ασφαλείας βάσης δεδομένων του UpdraftPlus είναι κρυπτογραφημένο. Αποκρυπτογραφήστε το στο UpdraftPlus (ή απενεργοποιήστε την κρυπτογράφηση της βάσης δεδομένων και δημιουργήστε ξανά αντίγραφο ασφαλείας) και, στη συνέχεια, εισαγάγετέ το."

#: includes/import/class-formats.php:76
msgid "Database dump"
msgstr "Αντίγραφο βάσης δεδομένων"

#. translators: %s: file name.
#: includes/import/class-formats.php:93
#, php-format
msgid "%s is not a backup archive we can read (zip, tar, tar.gz, .wpress, .sql or .sql.gz)."
msgstr "Το %s δεν είναι αρχείο αντιγράφου ασφαλείας που μπορούμε να διαβάσουμε (zip, tar, tar.gz, .wpress, .sql ή .sql.gz)."

#: includes/import/class-formats.php:99
msgid "Website archive"
msgstr "Αρχείο ιστοτόπου"

#. translators: %s: file name.
#: includes/import/class-formats.php:123
#, php-format
msgid "%s has no WordPress content (no wp-content folder and no database dump) in it."
msgstr "Το %s δεν περιέχει περιεχόμενο του WordPress (δεν υπάρχει φάκελος wp-content και δεν υπάρχει αντίγραφο βάσης δεδομένων)."

#: includes/import/class-formats.php:155
msgid "This .wpress file is encrypted or compressed by All-in-One WP Migration. Export it again with encryption and compression switched off, then import that."
msgstr "Αυτό το αρχείο .wpress είναι κρυπτογραφημένο ή συμπιεσμένο από το All-in-One WP Migration. Εξαγάγετέ το ξανά με την κρυπτογράφηση και τη συμπίεση απενεργοποιημένες και, στη συνέχεια, εισαγάγετέ το."

