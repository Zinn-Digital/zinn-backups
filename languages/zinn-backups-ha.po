msgid_plural "Backup complete: %1$s stored in %2$d destinations."
msgstr[0] "An kammala adana bayanai: an adana %1$s a makoma %2$d."
msgstr[1] "Ajiye bayanan ya kammala: An adana %1$s a wurare %2$d."

#: includes/class-backup-job.php:503
msgid "Some parts already uploaded could not be removed from your storage; they are in an incomplete backup folder and are never offered for restore."
msgstr "Ba a iya cire wasu ɓangarorin da aka riga aka ɗora daga ma'ajiyar ku ba; suna cikin babban fayil ɗin ajiya wanda ba a kammala ba kuma ba za a taɓa bayar da su don dawo da su ba."

#: includes/class-backup-job.php:520
msgid "A storage destination was removed while the backup was running."
msgstr "An cire wurin ajiya yayin da ake gudanar da aikin ajiye bayanan."

#: includes/class-catalog.php:134
msgid "That is not a backup folder."
msgstr "Wannan ba babban fayil ɗin ajiya ba ne."

#: includes/class-catalog.php:138
#: includes/class-restore-job.php:186
msgid "That storage destination is no longer saved on this site."
msgstr "Wannan wurin ajiyar ba a sake adana shi a wannan rukunin yanar gizon ba."

#: includes/class-catalog.php:141
msgid "Later incremental backups are built on this one. Delete those first."
msgstr "Karin madadin ajiyar bayanan na baya sun dogara ne a kan wannan. Da farko share wadannan."

#: includes/class-crypto.php:88
msgid "This file is not an encrypted Zinn® Backups file."
msgstr "Wannan fayil ɗin ba ɓoyayyen fayil ɗin Zinn® Backups ba ne."

#: includes/class-crypto.php:103
msgid "The backup could not be decrypted: the passphrase is wrong or the file is damaged."
msgstr "Ba a iya buɗe ɓoyayyen bayanin ajiyar ba: kalmar wucewa ba daidai ba ce ko kuma fayil ɗin ya lalace."

#: includes/class-crypto.php:112
msgid "The encrypted backup file is incomplete."
msgstr "Fayil ɗin ajiyar na'ura mai rufaffen sirri bai cika ba."

#: includes/class-database-dumper.php:67
msgid "The database file could not be written. Check that wp-content has free space."
msgstr "Ba a iya rubuta fayil ɗin ma’ajiyar bayanai ba. Duba ko akwai sarari a cikin wp-content."

#: includes/class-deploy-code.php:41
msgid "That is not a deploy code. A deploy code starts with zbdeploy1."
msgstr "Wannan ba lambar turawa ba ce. Lambar turawa tana farawa ne da zbdeploy1."

#: includes/class-deploy-code.php:46
#: includes/class-deploy-code.php:67
#: includes/class-deploy-code.php:76
msgid "That deploy code is damaged. Copy it again from the other site."
msgstr "Wannan lambar tura aikin ta lalace. Sake kwafarta daga ɗayan rukunin yanar gizon."

#: includes/class-deploy-code.php:56
msgid "The deploy code has expired or its backup was deleted. Make a new code on the other site."
msgstr "Lambar tura aikin ta kare ko kuma an goge ajiyar tsaronta. Samar da sabuwar lamba a dayan shafin."

#: includes/class-deploy-code.php:60
msgid "That deploy code does not point at a Zinn® Backups backup."
msgstr "Wannan lambar tura aiki ba ta nuna wani ajiyar Zinn® Backups ba."

#: includes/class-deploy-code.php:63
msgid "The deploy code has expired. Make a new code on the other site."
msgstr "Lambar tura aikin ta ƙare. Ƙirƙiri sabuwar lamba a ɗayan shafin."

#: includes/class-downloader.php:83
msgid "The server stopped honouring partial downloads. Start the import again."
