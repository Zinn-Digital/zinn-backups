#: includes/class-admin.php:288
#, php-format
msgid "Backups go to your own storage, not this server. <a href=\"%s\">Connect your storage</a> first."
msgstr "Ehtiyat nüsxələr bu serverə deyil, sizin öz yaddaşınıza göndərilir. Əvvəlcə <a href=\"%s\">yaddaşınızı qoşun</a>."

