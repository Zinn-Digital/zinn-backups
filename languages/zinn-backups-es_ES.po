#: includes/class-backup-job.php:209
#, php-format
msgid "Database: %1$d tables, %2$s rows, %3$s compressed."
msgstr "Base de datos: %1$d tablas, %2$s filas, %3$s comprimido."

#. translators: 1: size of the backup, 2: number of destinations.
#: includes/class-backup-job.php:473
#, php-format
msgid "Backup complete: %1$s stored in %2$d destination."
msgid_plural "Backup complete: %1$s stored in %2$d destinations."
msgstr[0] "Copia de seguridad completada: %1$s guardado en %2$d destino."
msgstr[1] "Copia de seguridad completada: %1$s guardado en %2$d destinos."
msgstr[2] "Copia de seguridad completada: %1$s guardado en %2$d destinos."

#: includes/class-backup-job.php:503
msgid "Some parts already uploaded could not be removed from your storage; they are in an incomplete backup folder and are never offered for restore."
msgstr "Algunas partes ya subidas no se pudieron eliminar de tu almacenamiento; están en una carpeta de copia de seguridad incompleta y nunca se ofrecerán para restaurar."

#: includes/class-backup-job.php:520
msgid "A storage destination was removed while the backup was running."
msgstr "Se eliminó un destino de almacenamiento mientras se ejecutaba la copia de seguridad."

#: includes/class-catalog.php:134
msgid "That is not a backup folder."
msgstr "Esa no es una carpeta de copia de seguridad."

#: includes/class-catalog.php:138
#: includes/class-restore-job.php:186
msgid "That storage destination is no longer saved on this site."
msgstr "Ese destino de almacenamiento ya no está guardado en este sitio."

#: includes/class-catalog.php:141
msgid "Later incremental backups are built on this one. Delete those first."
msgstr "Las copias de seguridad incrementales posteriores se basan en esta. Elimínalas primero."

#: includes/class-crypto.php:88
msgid "This file is not an encrypted Zinn® Backups file."
msgstr "Este archivo no es un archivo cifrado de Zinn® Backups."

#: includes/class-crypto.php:103
msgid "The backup could not be decrypted: the passphrase is wrong or the file is damaged."
msgstr "No se pudo descifrar la copia de seguridad: la frase de contraseña es incorrecta o el archivo está dañado."

#: includes/class-crypto.php:112
msgid "The encrypted backup file is incomplete."
msgstr "El archivo de copia de seguridad cifrado está incompleto."

#: includes/class-database-dumper.php:67
msgid "The database file could not be written. Check that wp-content has free space."
msgstr "No se pudo escribir el archivo de base de datos. Comprueba que wp-content tenga espacio libre."

#: includes/class-deploy-code.php:41
msgid "That is not a deploy code. A deploy code starts with zbdeploy1."
msgstr "Ese no es un código de despliegue. Un código de despliegue comienza con zbdeploy1."

#: includes/class-deploy-code.php:46
#: includes/class-deploy-code.php:67
#: includes/class-deploy-code.php:76
msgid "That deploy code is damaged. Copy it again from the other site."
msgstr "Ese código de despliegue está dañado. Cópialo de nuevo desde el otro sitio."

#: includes/class-deploy-code.php:56
msgid "The deploy code has expired or its backup was deleted. Make a new code on the other site."
msgstr "El código de despliegue ha caducado o se ha eliminado su copia de seguridad. Crea un nuevo código en el otro sitio."

#: includes/class-deploy-code.php:60
msgid "That deploy code does not point at a Zinn® Backups backup."
msgstr "Ese código de despliegue no apunta a una copia de seguridad de Zinn® Backups."

#: includes/class-deploy-code.php:63
msgid "The deploy code has expired. Make a new code on the other site."
msgstr "El código de despliegue ha caducado. Crea un código nuevo en el otro sitio."

#: includes/class-downloader.php:83
msgid "The server stopped honouring partial downloads. Start the import again."
msgstr "El servidor ha dejado de admitir descargas parciales. Vuelve a iniciar la importación."

#: includes/class-downloader.php:87
msgid "The link opened a web page instead of a file. For Google Drive and Dropbox, share the file with “anyone with the link” and paste that link."
msgstr "El enlace ha abierto una página web en lugar de un archivo. Para Google Drive y Dropbox, comparte el archivo con «cualquiera que tenga el enlace» y pega ese enlace."

#. translators: %d: HTTP status code.
#: includes/class-downloader.php:96
#, php-format
msgid "The link answered with HTTP %d."
msgstr "El enlace respondió con HTTP %d."

#: includes/class-file-scanner.php:53
msgid "The file list could not be written."
msgstr "No se ha podido escribir la lista de archivos."

#. translators: %s: the network error message.
#: includes/class-http.php:46
#, php-format
msgid "The storage service could not be reached: %s"
msgstr "No se ha podido conectar con el servicio de almacenamiento: %s"

#. translators: 1: service name, 2: HTTP status code, 3: the service's own error text.
#: includes/class-http.php:78
#, php-format
msgid "%1$s answered with HTTP %2$d: %3$s"
msgstr "%1$s respondió con HTTP %2$d: %3$s"

#: includes/class-http.php:113
msgid "no details given"
msgstr "No se proporcionaron detalles"

#: includes/class-plugin.php:96
msgid "You are not allowed to manage backups."
msgstr "No tienes permiso para gestionar copias de seguridad."

#: includes/class-plugin.php:196
msgid "Tick the box to confirm that the restore replaces this site’s files and database."
